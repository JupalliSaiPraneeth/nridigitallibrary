# Digital Library College Backend API Environment Configuration

NODE_ENV=production
PORT=5000
SERVER_ID=api-1

# Physical Book Storage Folder (Do not expose directly to web)
BOOK_STORAGE_PATH=C:\e book

# Allowed Frontend Origins for CORS (Comma-separated)
ALLOWED_ORIGIN=https://*.vercel.app,http://localhost:3000,http://localhost:5000

# Logging Level
LOG_LEVEL=info
