# Digital Library College Backend API Environment Configuration

NODE_ENV=production
PORT=5000
SERVER_ID=api-1

# Physical/NAS Shared Book Storage Directory (Do not expose directly to web)
BOOK_STORAGE_PATH=C:\e book

# Allowed Frontend Origin for CORS (Production: https://library.college.edu)
FRONTEND_URL=https://library.college.edu

# Logging Level
LOG_LEVEL=info
