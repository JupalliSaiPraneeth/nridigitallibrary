# ==============================================================================
# DIGITAL LIBRARY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vite & Vercel)
# ------------------------------------------------------------------------------
# Active Laptop Server Network Address:
# Accessible locally and from any mobile device / laptop on Wi-Fi (192.168.0.4)
VITE_LIBRARY_API_URL=http://192.168.0.4:8000

# ------------------------------------------------------------------------------
# 2. Book Storage Directory
# ------------------------------------------------------------------------------
# Your actual Laptop Downloads Book Folder:
BOOK_STORAGE_PATH=C:\Users\jupal\Downloads\books

# ------------------------------------------------------------------------------
# 3. Server Network & Port Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
COLLEGE_SERVER_IP=192.168.0.4

# ------------------------------------------------------------------------------
# 4. CORS & Security Settings
# ------------------------------------------------------------------------------
# Allows connections from Vercel, localhost, and other devices on local Wi-Fi (192.168.0.4)
ALLOWED_ORIGIN=https://*.vercel.app,http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://192.168.0.4:3000,http://192.168.0.4:8000,*

# Rate Limiting (Requests per minute per IP for books catalog and file downloads)
RATE_LIMIT_PER_MINUTE=500

# Environment Mode
NODE_ENV=development
