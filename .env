# ==============================================================================
# DIGITAL LIBRARY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vite & Vercel)
# ------------------------------------------------------------------------------
# In local development: Points to your college server or local backend
# In Vercel Production Settings: Set this to your Cloudflare Tunnel / Public HTTPS domain:
# e.g., https://api.library.college.edu or https://api.yourdomain.com
VITE_LIBRARY_API_URL=http://172.11.1.71:5000

# ------------------------------------------------------------------------------
# 2. College Server Physical Book Storage (75GB+)
# ------------------------------------------------------------------------------
# Windows Server Path Example: C:\e book or D:\CollegeLibrary\Books
# Linux Server Path Example:   /var/library/books
BOOK_STORAGE_PATH=C:\e book

# ------------------------------------------------------------------------------
# 3. College Server Backend API Network Settings
# ------------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
COLLEGE_SERVER_IP=172.11.1.71

# ------------------------------------------------------------------------------
# 4. CORS & Security Settings
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment & localhost)
# Supports wildcards such as https://*.vercel.app
ALLOWED_ORIGIN=https://*.vercel.app,http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# Rate Limiting (Requests per minute per IP for books catalog and file downloads)
RATE_LIMIT_PER_MINUTE=500

# Environment Mode
NODE_ENV=development
