# ==============================================================================
# DIGITAL LIBRARY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vite & Vercel)
# ------------------------------------------------------------------------------
# Production HTTPS Tunnel (Required for Safari on macOS to prevent Mixed Content blocking):
VITE_LIBRARY_API_URL=https://nova-university-lisa-assets.trycloudflare.com
# Local Wi-Fi fallback (for direct LAN access):
# VITE_LIBRARY_API_URL=http://192.168.0.5:8000

# ------------------------------------------------------------------------------
# 2. Book Storage Directory
# ------------------------------------------------------------------------------
# Your actual Laptop Downloads Book Folder:
BOOK_STORAGE_PATH=C:\Users\jupal\Downloads\books

# ------------------------------------------------------------------------------
# 3. Server Network & Port Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
COLLEGE_SERVER_IP=192.168.0.5

# ------------------------------------------------------------------------------
# 4. CORS & Security Settings
# ------------------------------------------------------------------------------
# Allows connections from Vercel, localhost, and other devices on local Wi-Fi (192.168.0.5)
ALLOWED_ORIGIN=https://*.vercel.app,http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://192.168.0.5:3000,http://192.168.0.5:8000,*

# Rate Limiting (Requests per minute per IP for books catalog and file downloads)
RATE_LIMIT_PER_MINUTE=500

# Environment Mode
NODE_ENV=development
