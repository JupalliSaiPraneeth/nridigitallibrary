# ==============================================================================
# DIGITAL LIBRARY - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# 1. Frontend Configuration (Vite & Vercel)
# Production: Set to your public HTTPS API domain via Cloudflare Tunnel / NGINX
# Example: https://api.yourdomain.com
VITE_LIBRARY_API_URL=https://api.yourdomain.com

# 2. College Server Physical Book Storage (75GB+)
# Windows: D:\CollegeLibrary\Books or C:\e book
# Linux:   /var/library/books
BOOK_STORAGE_PATH=D:\CollegeLibrary\Books

# 3. College Server Backend API Network Settings
PORT=5000
HOST=0.0.0.0
COLLEGE_SERVER_IP=172.11.1.71

# 4. CORS & Security Settings
# Add your production Vercel deployment URL here:
ALLOWED_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app,http://localhost:3000

# Rate Limiting & Node Environment
RATE_LIMIT_PER_MINUTE=500
NODE_ENV=production
